# Gemini API (Get from: https://ai.google.dev/)
# Server-side only - DO NOT prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API (Get from: https://elevenlabs.io/)
# Server-side only - DO NOT prefix with NEXT_PUBLIC_
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs Voice ID (default will be used if not set)
ELEVENLABS_VOICE_ID=your_voice_id_here

# Google Cloud Text-to-Speech API (Get from: https://console.cloud.google.com/apis/credentials)
# Server-side only - DO NOT prefix with NEXT_PUBLIC_
# Used as fallback when ElevenLabs quota is exceeded
# 1. Enable Text-to-Speech API in Google Cloud Console
# 2. Create API key in Credentials
# 3. Restrict key to Text-to-Speech API for security
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Alternative: Use service account JSON file instead of API key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Calendar Integration (for "Add to Calendar" in summary)
# Client-side only — MUST be prefixed with NEXT_PUBLIC_
# 1. Go to Google Cloud Console → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:3003 as an authorized JavaScript origin
# 4. Enable the Google Calendar API in APIs & Services → Library
# 5. Keep the app in "Testing" mode; add your Google account as a test user
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Deepgram API (optional - alternative transcription)
# DEEPGRAM_API_KEY=your_deepgram_api_key
